# Cutter Management Service Configuration

# Server
HOST=0.0.0.0
PORT=8001
DEBUG=false

# Database
DATABASE_URL=postgresql://user:pass@postgres:5432/cutter_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# RabbitMQ
RABBITMQ_URL=amqp://rabbitmq:5672
RABBITMQ_EXCHANGE=cnc_events
RABBITMQ_QUEUE=cutter_events

# Redis (for caching)
REDIS_URL=redis://redis:6379/1

# JWT (for service-to-service auth)
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Health Check
HEALTH_CHECK_INTERVAL=30

# Event Publishing
EVENT_PUBLISH_ENABLED=true