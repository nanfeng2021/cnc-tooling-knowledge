# Ultra-lightweight AI Service using FastEmbed
FROM python:3.11-slim

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install dependencies
COPY requirements-fastembed.txt .
RUN pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com -r requirements-fastembed.txt

# Copy source code
COPY app_fastembed.py .

# Create directory for vector store
RUN mkdir -p /app/vector_store

# Expose API port
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/health')" || exit 1

# Start the AI service
CMD ["python", "-m", "uvicorn", "app_fastembed:app", "--host", "0.0.0.0", "--port", "8001"]