# AI Service Configuration

# Server
HOST=0.0.0.0
PORT=8002
DEBUG=false

# ChromaDB
CHROMA_PERSIST_DIR=/app/vector_store
CHROMA_COLLECTION=cutter_knowledge

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# RabbitMQ
RABBITMQ_URL=amqp://rabbitmq:5672
RABBITMQ_EXCHANGE=cnc_events
RABBITMQ_QUEUE=ai_events

# Redis (for caching)
REDIS_URL=redis://redis:6379/2

# Cutter Management Service
CUTTER_SERVICE_URL=http://cutter-management:8001

# JWT (for service-to-service auth)
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Health Check
HEALTH_CHECK_INTERVAL=30

# Model Configuration
MODEL_CACHE_DIR=/app/models
MAX_SEQUENCE_LENGTH=512

# Search Configuration
SEARCH_DEFAULT_TOP_K=10
SEARCH_MAX_TOP_K=100
SEARCH_SIMILARITY_THRESHOLD=0.7

# Recommendation Configuration
RECOMMENDATION_MAX_RESULTS=5
RECOMMENDATION_MIN_CONFIDENCE=0.6

# Scenario Matching Configuration
SCENARIO_MATCHING_MAX_RESULTS=10
SCENARIO_MATCHING_MIN_SCORE=0.5